Conditions:
```````````

1) if...then...fi
```````````````````````````````
#!/bin/bash
read -p "Enter : " a

if [ "$a" -eq "1" ];then
	echo "cool"
fi

2) if...then...else...fi
````````````````````````````
#!/bin/bash
read -p "Enter : " a

if [ "$a" -eq "1" ];then
	echo "cool"
else
	echo "oops"
fi

3) if...then...elif...then...fi
``````````````````````````````````
#!/bin/bash
read -p "Enter : " a

if [ "$a" -eq "1" ];then
	echo "cool"
elif [ "$a" -eq "2" ];then
	echo "sparta"
fi


4) if...then...elif...then...else...fi
``````````````````````````````````````````
#!/bin/bash
read -p "Enter : " a

if [ "$a" -eq "1" ];then
	echo "cool"
elif [ "$a" -eq "2" ];then
	echo "sparta"
else
	echo "oops"
fi

